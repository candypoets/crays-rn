# Optional: point a device at the compatibility proxy on the development host.
# Start it with: CRAYS_TEST_ROOM_PROXY=1 npm run test-room
# EXPO_PUBLIC_CRAYS_TEST_RELAY_URL=ws://192.168.1.20:8787
# EXPO_PUBLIC_CRAYS_TEST_ROOM_ID=crays-test-room
# Hosted Stripe checkout defaults to the shared Nuts payment service. QA may
# replace this at Metro bundle time with a deterministic checkout adapter.
# EXPO_PUBLIC_PAYMENT_SERVICE_URL=https://payments.nuts.cash
