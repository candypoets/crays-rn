{
  "name": "crays-rn",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --dev-client",
    "start:maestro": "set -a; [ ! -f .env.test-room-build ] || . ./.env.test-room-build; set +a; export EXPO_PUBLIC_BLOSSOM_SERVER=${EXPO_PUBLIC_BLOSSOM_SERVER:-http://10.0.2.2:8791}; expo start --dev-client --port 8085",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "qa:maestro": "MAESTRO_CLI_NO_ANALYTICS=1 npm run qa:journey -- cold-signup",
    "qa:list": "node .qa/run-scenario.mjs --list",
    "qa:list:all": "node .qa/run-scenario.mjs --list-all",
    "qa:journey": "node .qa/run-scenario.mjs",
    "qa:entry": "node .qa/run-scenario.mjs cold-signup",
    "qa:contracts": "node .qa/verify-screen-contracts.mjs && node --test .qa/relay-cleanup.test.mjs",
    "qa:relay:bootstrap": "node .qa/relay-bootstrap.mjs",
    "qa:relay:verify": "node .qa/relay-verify.mjs",
    "qa:relay:teardown": "node .qa/relay-teardown.mjs",
    "test-room": "node .qa/test-room.mjs",
    "test-room:publish": "CRAYS_TEST_ROOM_PUBLISH=1 node .qa/test-room.mjs",
    "test-room:stop": "node .qa/test-room-stop.mjs",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@candypoets/nipworker": "0.99.9",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "flatbuffers": "25.2.10",
    "nativewind": "^4.2.4",
    "nostr-tools": "^2.24.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-ble-plx": "^3.5.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
